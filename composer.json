{
    "name": "builtbyberry/laravel-swarm-mcp",
    "description": "Read-only Model Context Protocol (MCP) server for Laravel Swarm — expose durable run history, durable-run inspection, and audit-outbox health as MCP Resources over the official laravel/mcp package.",
    "keywords": ["laravel", "ai", "agents", "swarm", "mcp", "observability"],
    "homepage": "https://swarm.builtbyberry.com",
    "support": {
        "docs": "https://swarm.builtbyberry.com",
        "issues": "https://github.com/builtbyberry/laravel-swarm-mcp/issues",
        "source": "https://github.com/builtbyberry/laravel-swarm-mcp"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Daniel Berry",
            "email": "daniel@jstreetdigital.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.5",
        "builtbyberry/laravel-swarm": "^0.19",
        "illuminate/contracts": "^13.0",
        "illuminate/support": "^13.0",
        "laravel/mcp": "^0.8",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "larastan/larastan": "^3.10",
        "laravel/pint": "^1.29",
        "orchestra/testbench": "^11.1",
        "pestphp/pest": "^4.7",
        "pestphp/pest-plugin-laravel": "^4.1"
    },
    "autoload": {
        "psr-4": {
            "BuiltByBerry\\LaravelSwarmMcp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BuiltByBerry\\LaravelSwarmMcp\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        },
        "laravel": {
            "providers": [
                "BuiltByBerry\\LaravelSwarmMcp\\SwarmMcpServiceProvider"
            ]
        }
    },
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse --memory-limit=2G --no-progress",
        "format": "vendor/bin/pint",
        "lint": "vendor/bin/pint --test",
        "test": "vendor/bin/pest tests/Feature"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
